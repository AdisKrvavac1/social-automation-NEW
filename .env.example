# ── Aplikacija ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://objave.norvelstudio.com
# openssl rand -base64 32
AUTH_SECRET=
# openssl rand -hex 32   (tačno 64 heks znaka; NE MIJENJATI nakon što se povežu nalozi)
ENCRYPTION_KEY=

# ── Baza i Redis (na Railwayu se postavljaju referencama na servise) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mm_objave?schema=public
REDIS_URL=redis://localhost:6379

# ── Meta (Facebook i Instagram) ───────────────────────────────
META_APP_ID=
META_APP_SECRET=
# Provjeri aktuelnu verziju: developers.facebook.com/docs/graph-api/changelog
META_GRAPH_VERSION=v23.0

# ── Cloudflare R2 (fotografije) ───────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mm-objave-media
R2_PUBLIC_URL=https://media.norvelstudio.com

# ── AI tekstovi (Google Gemini) ───────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="MM Objave <objave@norvelstudio.com>"
ADMIN_ALERT_EMAIL=

# ── Opcionalno ────────────────────────────────────────────────
CRON_TZ=Europe/Sarajevo
ENABLE_DB_BACKUP=false
ENABLE_TIKTOK=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Seed (samo za `npm run seed`, lozinke najmanje 12 znakova) ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Ema
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
SEED_STAFF_NAME=Osoblje MM
