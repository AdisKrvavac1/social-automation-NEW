generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ADMIN = Norvel (sve restorane), OWNER = vlasnik restorana, STAFF = osoblje
enum Role {
  ADMIN
  OWNER
  STAFF
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum PostType {
  DNEVNI_MENI
  JELO_DANA
  ZELENA_OAZA
  CATERING
  DOGADJAJ
  OSTALO
}

enum PostStatus {
  PENDING_APPROVAL
  SCHEDULED
  PROCESSING
  PUBLISHED
  FAILED
  REJECTED
}

model Restaurant {
  id                 String          @id @default(cuid())
  name               String
  slug               String          @unique
  timezone           String          @default("Europe/Sarajevo")
  defaultPostTime    String          @default("11:00")
  // Minute prije termina kada objava ide automatski ako vlasnik ne odgovori. 0 = uvijek čeka ručno odobrenje.
  autoPublishMinutes Int             @default(30)
  // { tone, facts[], hashtags[], bannedWords[] } – koristi AI za tekstove
  brandVoice         Json?
  users              User[]
  socialAccounts     SocialAccount[]
  posts              Post[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String      @unique
  passwordHash  String
  role          Role        @default(STAFF)
  restaurantId  String?
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  postsCreated  Post[]      @relation("PostCreatedBy")
  postsApproved Post[]      @relation("PostApprovedBy")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model SocialAccount {
  id             String     @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  platform       Platform
  platformUserId String
  accountName    String
  // AES-256-GCM šifrovano (lib/encryption.ts)
  accessToken    String     @db.Text
  refreshToken   String?    @db.Text
  // null = token ne ističe (Facebook page token iz dugotrajnog user tokena)
  tokenExpiresAt DateTime?
  needsReconnect Boolean    @default(false)
  posts          Post[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([restaurantId, platform, platformUserId])
}

model Post {
  id               String        @id @default(cuid())
  // Ista objava na više mreža dijeli groupId i odobrava se zajedno
  groupId          String
  restaurantId     String
  restaurant       Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  socialAccountId  String
  socialAccount    SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?         @relation("PostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById     String?
  approvedBy       User?         @relation("PostApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  type             PostType      @default(OSTALO)
  platform         Platform
  content          String?       @db.Text
  mediaUrls        String[]
  status           PostStatus    @default(PENDING_APPROVAL)
  scheduledFor     DateTime
  approvalDeadline DateTime?
  approvedAt       DateTime?
  autoApproved     Boolean       @default(false)
  publishedAt      DateTime?
  platformPostId   String?
  likesCount       Int           @default(0)
  commentsCount    Int           @default(0)
  sharesCount      Int           @default(0)
  viewsCount       Int           @default(0)
  metricsUpdatedAt DateTime?
  errorLog         String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, scheduledFor])
  @@index([restaurantId, status])
  @@index([groupId])
}
