{
  "name": "mm-objave",
  "version": "0.1.0",
  "private": true,
  "description": "MM Objave by Norvel: automatske objave za Facebook i Instagram s odobrenjem vlasnika",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start -p ${PORT:-3000}",
    "worker": "tsx worker.ts",
    "seed": "tsx prisma/seed.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@google/genai": "^3.3.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.32",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.16.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  }
}
